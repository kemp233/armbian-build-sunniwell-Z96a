From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenClaw <openclaw@local>
Date: Thu, 13 Aug 2026 00:00:00 +0000
Subject: z96a: add violent Mux for LCD power in PM domain driver

Force GPIO0 PC7 (vcc3v3_lcd0_n enable) high for LCD power in
rockchip_pm_domain_drv_register. The DTS regulator removal is done
directly in rk3568-z96a-laptop-v2.dts (via dts-directories copy).

Signed-off-by: OpenClaw <openclaw@local>
---
 drivers/soc/rockchip/pm_domains.c | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git  a/drivers/soc/rockchip/pm_domains.c  b/drivers/soc/rockchip/pm_domains.c
index 006a1f5..ab0acd4 100644
---  a/drivers/soc/rockchip/pm_domains.c
+++  b/drivers/soc/rockchip/pm_domains.c
@@ -2456,7 +2456,22 @@ static struct platform_driver rockchip_pm_domain_driver = {
 
 static int __init rockchip_pm_domain_drv_register(void)
 {
-	return platform_driver_register(&rockchip_pm_domain_driver);
+	/* Violent Mux for Z96A: Force GPIO0 PC7 (vcc3v3_lcd0_n enable) to output high */
+	{
+		void __iomem *grf_base = ioremap(0xfd400000, 0x10000);
+		if (grf_base) {
+			/* GPIO0C_IOMUX_H (offset 0x00e8): PC7 = GPIO (func 0) */
+			writel(0xffff0000, grf_base + 0x00e8);
+			/* GPIO0C_DRV (offset 0x0188): PC7 drive strength max */
+			writel(0x0000ff00, grf_base + 0x0188);
+			/* GPIO0_SWPORTA_DR (offset 0x0000): set PC7 high */
+			writel(readl(grf_base + 0x0000) | (1 << 7), grf_base + 0x0000);
+			iounmap(grf_base);
+			pr_info("z96a: violent mux applied - GPIO0 PC7 forced high for vcc3v3_lcd0_n\n");
+		}
+	}
+
+		return platform_driver_register(&rockchip_pm_domain_driver);
 }
 postcore_initcall(rockchip_pm_domain_drv_register);
 
