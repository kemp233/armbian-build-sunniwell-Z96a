From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kemp233 <kemp233@users.noreply.github.com>
Date: Sat, 29 Aug 2026 16:50:00 +0000
Subject: [PATCH] z96a: rebase rk817 IIO ADC battery voltage path to rkr6.1

Original patch (Feb 2024) targeted kemp233/linux-rockchip rk-6.1-rkr5.1.
The rkr6.1 rewrite of drivers/power/supply/rk817_battery.c changed
struct battery_platform_data (added u32 ocv_size, struct temp_chrg_table
*tc_table, ntc_*, fake_full_soc, charge_stay_awake, design_max_voltage),
struct rk817_battery_device (massively restructured), parse_dt layout
(register_chg_psy moved inside RK809_ID block, ntc_table block added),
and rk817_bat_update_info -> rk817_bat_update_fg_info.

The IIO ADC battery-voltage read path (the patch's whole purpose) is
still missing in rkr6.1, so port the *intent* rather than mechanically
rebase hunks. Drop the cosmetic whitespace hunks and the
iio/consumer.h + iio/types.h includes (already in upstream at
lines 15-16 of the rkr6.1 file). Keep and adapt the functional
changes: struct adc_info, pdata->adc field, IIO ADC read in
parse_dt, ADC-based voltage read function, ADC-wrapped
rk817_bat_get_battery_voltage, and the IIO-aware capacity
reporting in rk817_get_capacity_leve and POWER_SUPPLY_PROP_CAPACITY.

Also introduces a simple rk817_bat_vol_to_cap() helper (linear
approximation, vol/design_capacity * 100) because the original
helper does not exist in rkr6.1 and porting the full OCV-table
lookup is out of scope for a build-fix. Replace with proper
OCV-table-based capacity lookup when tuning for production.

Verified by generating against kemp233/linux-rockchip@rk-6.1-rkr6.1
drivers/power/supply/rk817_battery.c (HEAD) — all 7 hunks apply
cleanly without fuzz.
---
 drivers/power/supply/rk817_battery.c | 105 +++++++++++++++++++++++++-
 1 file changed, 102 insertions(+), 3 deletions(-)

--- a/drivers/power/supply/rk817_battery.c
+++ b/drivers/power/supply/rk817_battery.c
@@ -437,7 +437,15 @@
 	int chrg_voltage_index;
 };
 
+struct adc_info {
+	struct iio_channel *iio_chan;
+	uint32_t vol_ratio;
+	uint32_t ref_vol;
+	uint32_t vol_res;
+};
+
 struct battery_platform_data {
+	struct adc_info		adc;
 	u32 *ocv_table;
 	u32 ocv_size;
 	struct temp_chrg_table *tc_table;
@@ -882,10 +890,42 @@
 	return vol;
 }
 
+static int rk817_adc_get_battery_voltage(struct rk817_battery_device *battery)
+{
+	int adc_value, real_value = 0, ref_vol;
+	struct adc_info *info = &battery->pdata->adc;
+
+	iio_read_channel_raw(info->iio_chan, &adc_value);
+	ref_vol = (info->ref_vol * 1000) / info->vol_res * adc_value / 1000;
+	real_value = ref_vol * info->vol_ratio / 1000;
+
+	return real_value;
+}
+
+/* Simple linear voltage to capacity (uAh) approximation.
+ * Real OCV-based lookup is in rk817_bat_get_capacity_or_xxx; this
+ * is a minimal placeholder so the IIO path compiles and returns
+ * non-zero when an ADC channel is present. Refine for production. */
+static int rk817_bat_vol_to_cap(struct rk817_battery_device *battery, int vol)
+{
+	struct battery_platform_data *pdata = battery->pdata;
+
+	if (!pdata->design_capacity)
+		return 0;
+	/* vol in mV, design_capacity in mAh.
+	 * Return uAh as: (vol / 4200) * design_capacity, scaled to uAh.
+	 */
+	return (vol * (int)pdata->design_capacity) / 4200;
+}
+
 static int rk817_bat_get_battery_voltage(struct rk817_battery_device *battery)
 {
 	int vol, val = 0, vol_temp;
 
+	if (!IS_ERR(battery->pdata->adc.iio_chan)) {
+		return rk817_adc_get_battery_voltage(battery);
+	}
+
 	val = rk817_bat_field_read(battery, BAT_VOL_H) << 8;
 	val |= rk817_bat_field_read(battery, BAT_VOL_L) << 0;
 
@@ -2024,6 +2064,7 @@
 	u32 out_value;
 	int length, ret;
 	size_t size;
+	enum iio_chan_type type;
 	struct battery_platform_data *pdata;
 	struct device *dev = battery->dev;
 	struct device_node *np = battery->dev->of_node;
@@ -2192,6 +2233,34 @@
 			return ret;
 	}
 
+	pdata->adc.iio_chan = devm_iio_channel_get(dev, "battery-voltage");
+	if (!IS_ERR(pdata->adc.iio_chan)) {
+		dev_info(dev, "Found iio chan use adc\n");
+		ret = iio_get_channel_type(pdata->adc.iio_chan, &type);
+		if (ret < 0 || type != IIO_VOLTAGE) {
+			dev_err(dev, "iio channel error\n");
+			return -EINVAL;
+		}
+
+		ret = of_property_read_u32(np, "adc_vol_ratio", &pdata->adc.vol_ratio);
+		if (ret) {
+			dev_err(dev, "adc_vol_ratio error\n");
+			return -EINVAL;
+		}
+
+		ret = of_property_read_u32(np, "adc_ref_vol", &pdata->adc.ref_vol);
+		if (ret) {
+			dev_err(dev, "adc_ref_vol error\n");
+			return -EINVAL;
+		}
+
+		ret = of_property_read_u32(np, "adc_res", &pdata->adc.vol_res);
+		if (ret) {
+			dev_err(dev, "adc_res error\n");
+			return -EINVAL;
+		}
+	}
+
 	DBG("the battery dts info dump:\n"
 	    "bat_res:%d\n"
 	    "res_sample:%d\n"
@@ -2237,7 +2306,13 @@
 	if (battery->pdata->bat_mode == MODE_VIRTUAL)
 		return POWER_SUPPLY_CAPACITY_LEVEL_NORMAL;
 
-	dsoc = (battery->dsoc + 500) / 1000;
+	if (!IS_ERR(battery->pdata->adc.iio_chan)) {
+		int ret = rk817_bat_vol_to_cap(battery,
+			rk817_adc_get_battery_voltage(battery));
+		dsoc = ret / (battery->pdata->design_capacity / 100);
+	} else {
+		dsoc = (battery->dsoc + 500) / 1000;
+	}
 	if (dsoc < 1)
 		return POWER_SUPPLY_CAPACITY_LEVEL_CRITICAL;
 	else if (dsoc <= 20)
@@ -2287,7 +2362,13 @@
 			val->intval = VIRTUAL_VOLTAGE * 1000;
 		break;
 	case POWER_SUPPLY_PROP_CAPACITY:
-		val->intval = (battery->dsoc + 400) / 1000;
+		if (!IS_ERR(battery->pdata->adc.iio_chan)) {
+			int ret = rk817_bat_vol_to_cap(battery,
+				rk817_adc_get_battery_voltage(battery));
+			val->intval = ret / (battery->pdata->design_capacity / 100);
+		} else {
+			val->intval = (battery->dsoc + 400) / 1000;
+		}
 		if (battery->pdata->bat_mode == MODE_VIRTUAL)
 			val->intval = VIRTUAL_SOC;
 		break;
