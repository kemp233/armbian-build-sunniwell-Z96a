				rockchip,pins = <0x03 0x00 0x03 0x11d 0x02 0x1f 0x03 0x11d 0x02 0x1e 0x03 0x11d>;
				phandle = <0x303>;
			};

			spi2m1-cs0 {
				rockchip,pins = <0x02 0x1d 0x03 0x11d>;
				phandle = <0x304>;
			};

			spi2m1-cs1 {
				rockchip,pins = <0x02 0x1c 0x03 0x11d>;
				phandle = <0x305>;
			};
		};

		spi3-hs {

			spi3m0-pins {
				rockchip,pins = <0x04 0x0b 0x04 0x11d 0x04 0x08 0x04 0x11d 0x04 0x0a 0x04 0x11d>;
				phandle = <0xeb>;
			};

			spi3m0-cs0 {
				rockchip,pins = <0x04 0x06 0x04 0x11d>;
				phandle = <0x306>;
			};

			spi3m0-cs1 {
				rockchip,pins = <0x04 0x07 0x04 0x11d>;
				phandle = <0x307>;
			};

			spi3m1-pins {
				rockchip,pins = <0x04 0x12 0x02 0x11d 0x04 0x15 0x02 0x11d 0x04 0x13 0x02 0x11d>;
				phandle = <0x308>;
			};

			spi3m1-cs0 {
				rockchip,pins = <0x04 0x16 0x02 0x11d>;
				phandle = <0x309>;
			};

			spi3m1-cs1 {
