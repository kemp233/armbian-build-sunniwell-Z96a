		regulator-always-on;
		regulator-boot-on;
		gpio = <0x1e4 0x09 0x00>;
		vin-supply = <0x12f>;
		pinctrl-names = "default";
		pinctrl-0 = <0x412>;
		phandle = <0x414>;
	};

	sdio-pwrseq {
		status = "okay";
		compatible = "mmc-pwrseq-simple";
		clocks = <0x137 0x01>;
