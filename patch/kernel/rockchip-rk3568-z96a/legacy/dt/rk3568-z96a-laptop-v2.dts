		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <0x139>;
		WIFI,host_wake_irq = <0x41 0x14 0x00>;
		phandle = <0x321>;
	};

	wireless-bluetooth {
		compatible = "bluetooth-platdata";
		clocks = <0x137 0x01>;
		clock-names = "ext_clock";
		uart_rts_gpios = <0x132 0x0d 0x01>;
		pinctrl-names = "default\0rts_gpio";
		pinctrl-0 = <0x13a>;
		pinctrl-1 = <0x13b>;
		BT,reset_gpio = <0x41 0x11 0x00>;
		BT,wake_gpio = <0x41 0x0e 0x00>;
		BT,host_wake_irq = <0x41 0x14 0x00>;
