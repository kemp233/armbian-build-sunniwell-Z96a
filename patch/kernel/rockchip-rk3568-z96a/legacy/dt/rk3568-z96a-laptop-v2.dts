		regulator-boot-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		vin-supply = <0x500>;
		phandle = <0x12f>;
	};

	vcc5v0-usb {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		vin-supply = <0x12f>;
		phandle = <0x112>;
	};

	vcc5v0-host-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		enable-active-high;
		gpio = <0x41 0x06 0x00>;
		vin-supply = <0x12f>;
		pinctrl-names = "default";
		pinctrl-0 = <0x131>;
		phandle = <0x114>;
	};

	vcc5v0-otg-regulator {
		compatible = "regulator-fixed";
		/* Z96A: KEEP ENABLED (always-on). Bench fact: the NIC behind
		 * the OTG controller is powered from this rail - disabling it
		 * (v6 test) killed the NIC in every power configuration. The
		 * charger-plugged VSYS sag that previously killed the NIC is
		 * addressed at the source instead (SC8886 charge current 1A
		 * programmed by U-Boot, u-boot-1 aebd0dc2+). */
		regulator-name = "vcc5v0_otg";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		enable-active-high;
		gpio = <0x41 0x05 0x00>;
		vin-supply = <0x12f>;
		pinctrl-names = "default";
		pinctrl-0 = <0x133>;
		phandle = <0x40>;
	};


	z96a-keyboad-vcc {
		compatible = "regulator-fixed";
		/* Z96A factory (Android boot-0.dts): keyboard 5V EN = gpio2_D7 */
		gpio = <0x132 0x1f 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x410>;
		regulator-name = "z96a_keyboad_vcc";
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x31f>;
	};

	z96a-camera-vcc {
		compatible = "regulator-fixed";
		gpio = <0x132 0x10 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x136>;
		regulator-name = "z96a_camera_vcc";
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x320>;
	};

	/* Z96A factory rails (Android boot-0.dts vcc5v0-usb2-host1/2) */
	vcc5v0-usb2-host1 {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb2_host1";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
		gpio = <0x1e4 0x0b 0x00>;
		vin-supply = <0x12f>;
		pinctrl-names = "default";
