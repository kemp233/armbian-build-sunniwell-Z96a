	external-camera-clock {
		compatible = "fixed-clock";
		clock-frequency = <0x16e3600>;
		clock-output-names = "CLK_CAMERA_24MHZ";
		#clock-cells = <0x00>;
		phandle = <0x324>;
	};

	edp-panel {
		compatible = "simple-panel";
		status = "okay";
		// power-supply = <0x125>;  // disabled: violent mux handles LCD power
        power-supply = <0x125>;
	/* enable-gpios removed: GPIO0_A3 is the RK809 INT pin */
		bus-format = <0x100a>;
		bpc = <0x08>;
		width-mm = <0x135>;
		height-mm = <0xad>;
		prepare-delay-ms = <0x14>;
		enable-delay-ms = <0x14>;
		phandle = <0x325>;

		display-timings {
			native-mode = <0x13e>;

			timing0 {
				clock-frequency = <0x86d97c0>;
				hactive = <0x780>;
				vactive = <0x438>;
				hfront-porch = <0x30>;
				hsync-len = <0x20>;
				hback-porch = <0x8e>;
				vfront-porch = <0x03>;
				vsync-len = <0x06>;
				vback-porch = <0x0b>;
				hsync-active = <0x00>;
				vsync-active = <0x00>;
				de-active = <0x00>;
				pixelclk-active = <0x00>;
				phandle = <0x13e>;
			};
		};

		ports {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			port@0 {
				reg = <0x00>;

				endpoint {
					remote-endpoint = <0x13f>;
					status = "okay";
					phandle = <0xa5>;
				};
			};
		};
	};

vcc3v3-lcd0-n {
        compatible = "regulator-fixed";
        regulator-name = "vcc3v3_lcd0_n";
        regulator-boot-on;
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        enable-active-high;
        gpio = <0x41 0x17 0x00>;
        vin-supply = <0x129>;
        phandle = <0x125>;
};

