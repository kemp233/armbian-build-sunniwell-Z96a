	syscon@fdca8000 {
		compatible = "rockchip,rk3568-usb2phy-grf\0syscon";
		reg = <0x00 0xfdca8000 0x00 0x8000>;
		phandle = <0x113>;
	};

	syscon@fdcb0000 {
		compatible = "rockchip,rk3568-edp-phy-grf\0syscon\0simple-mfd";
		reg = <0x00 0xfdcb0000 0x00 0x100>;
		clocks = <0x23 0x192>;
		phandle = <0x172>;

		edp-phy {
			compatible = "rockchip,rk3568-edp-phy";
			clocks = <0x3b 0x29>;
			clock-names = "refclk";
			#phy-cells = <0x00>;
			status = "okay";
			phandle = <0xa3>;
		};
	};

	syscon@fdcb8000 {
		compatible = "rockchip,pcie30-phy-grf\0syscon";
		reg = <0x00 0xfdcb8000 0x00 0x10000>;
		phandle = <0x115>;
	};

	sram@fdcc0000 {
		compatible = "mmio-sram";
		reg = <0x00 0xfdcc0000 0x00 0xb000>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0xfdcc0000 0xb000>;
		phandle = <0x173>;

		rkvdec-sram@0 {
			reg = <0x00 0xb000>;
			phandle = <0x83>;
		};
	};

	clock-controller@fdd00000 {
		compatible = "rockchip,rk3568-pmucru";
		reg = <0x00 0xfdd00000 0x00 0x1000>;
		rockchip,grf = <0x3c>;
		rockchip,pmugrf = <0x3d>;
		#clock-cells = <0x01>;
		#reset-cells = <0x01>;
		assigned-clocks = <0x3b 0x32>;
		assigned-clock-parents = <0x3b 0x05>;
		phandle = <0x3b>;
	};

	clock-controller@fdd20000 {
		compatible = "rockchip,rk3568-cru";
		reg = <0x00 0xfdd20000 0x00 0x1000>;
		rockchip,grf = <0x3c>;
		#clock-cells = <0x01>;
		#reset-cells = <0x01>;
		assigned-clocks = <0x3b 0x05 0x23 0x106 0x23 0x10b 0x3b 0x01 0x3b 0x2b 0x23 0x03 0x23 0x19b 0x23 0x09 0x23 0x19c 0x23 0x19d 0x23 0x1a1 0x23 0x19e 0x23 0x19f 0x23 0x1a0 0x23 0x04 0x23 0x10d 0x23 0x10e 0x23 0x173 0x23 0x174 0x23 0x175 0x23 0x176 0x23 0xc9 0x23 0xca 0x23 0x06 0x23 0x7e 0x23 0x7f 0x23 0x3d 0x23 0x41 0x23 0x45 0x23 0x49 0x23 0x4d 0x23 0x4d 0x23 0x55 0x23 0x51 0x23 0x5d 0x23 0xdd>;
		assigned-clock-rates = <0x8000 0x11e1a300 0x11e1a300 0xbebc200 0x5f5e100 0x3b9aca00 0x1dcd6500 0x13d92d40 0xee6b280 0x7735940 0x5f5e100 0x3b9aca0 0x2faf080 0x17d7840 0x46cf7100 0x8f0d180 0x5f5e100 0x1dcd6500 0x17d78400 0x8f0d180 0x5f5e100 0x11e1a300 0x8f0d180 0x47868c00 0x17d78400 0x5f5e100 0x46cf7100 0x46cf7100 0x46cf7100 0x46cf7100 0x46cf7100 0x46cf7100 0x46cf7100 0x46cf7100 0x46cf7100 0x1dcd6500>;
		assigned-clock-parents = <0x3b 0x08 0x23 0x04 0x23 0x04>;
		phandle = <0x23>;
	};

	i2c@fdd40000 {
		compatible = "rockchip,rk3399-i2c";
		reg = <0x00 0xfdd40000 0x00 0x1000>;
		clocks = <0x3b 0x07 0x3b 0x2d>;
		clock-names = "i2c\0pclk";
		interrupts = <0x00 0x2e 0x04>;
		pinctrl-names = "default";
		pinctrl-0 = <0x3e>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "okay";
		phandle = <0x174>;

		cn3705@1c {
			compatible = "cellwise,cn3705";
			reg = <0x1c>;
			status = "okay";
			phandle = <0x175>;
		};

		sc8886@6b {
			compatible = "ti,bq25700\0southchip,sc8886";
			reg = <0x6b>;
			interrupt-parent = <0x41>;
			interrupts = <0x12 0x08>;
			ti,charge-current = <0xf4240>;
			ti,max-input-voltage = <0xe4e1c0>;
			ti,max-input-current = <0x5b8d80>;
			ti,max-charge-voltage = <0x803c20>;
			ti,input-current = <0x2dc6c0>;
			ti,input-current-sdp = <0x1e8480>;
			ti,input-current-dcp = <0x1e8480>;
			ti,input-current-cdp = <0x3567e0>;
			ti,minimum-sys-voltage = <0x64b540>;
			ti,otg-voltage = <0x4c4b40>;
			ti,otg-current = <0x7a120>;
			pd-charge-only = <0x00>;
			ntc_table = <0x1745f 0x161f3 0x14f87 0x13d1b 0x12aaf 0x11842 0x10ad6 0xfd6a 0xeffe 0xe292 0xd524 0xcb2e 0xc138 0xb742 0xad4c 0xa355 0x9bed 0x9485 0x8d1d 0x85b5 0x7e4a 0x78b7 0x7324 0x6d91 0x67fe 0x626a 0x5e31 0x59f8 0x55bf 0x5186 0x4d49 0x4a0f 0x46d5 0x439b 0x4061 0x3d23 0x3aa7 0x382b 0x35af 0x3333 0x30b4 0x2ec4 0x2cd4 0x2ae4 0x28f4 0x2710 0x258f 0x240e 0x228d 0x210c 0x1f88 0x1e59 0x1d2a 0x1bfb 0x1acc 0x199c 0x18ac 0x17bc 0x16cc 0x15dc 0x14ec 0x142d 0x136e 0x12af 0x11f0 0x1131 0x1098 0xfff 0xf66 0xecd 0xe33 0xdb8 0xd3d 0xcc2 0xc47 0xbcb 0xb68 0xb05 0xaa2 0xa3f 0x9d9>;
			ntc_degree_from = <0x01 0x14>;
			io-channels = <0x1dd 0x04>;
			io-channel-names = "temp-chan-4";
			temp_res_up = <0x2710>;
			low_temp_off = <0x00>;
			high_temp_off = <0x2b>;
			extcon = <&usb_con>, <&usb_con>;
			ti,usb-charger-detection = <&husb311_chg>;
			status = "okay";
			phandle = <0x176>;
			regulators {
				otg-vbus {
					regulator-name = "otg-vbus";
					regulator-min-microvolt = <5000000>;
					regulator-max-microvolt = <5000000>;
				};
			};
		};

		husb311_chg: husb311@4e {
			compatible = "hynetek,husb311";
			reg = <0x4e>;
			pinctrl-names = "default";
			pinctrl-0 = <0x3f>;
			/* vcc5v0_usb (0x112): known-good VBUS rail on V2 */
			vbus-supply = <0x112>;
			interrupt-parent = <0x41>;
			interrupts = <0x1d 0x08>;
			status = "okay";
			phandle = <0x177>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x00>;

					endpoint@0 {
						reg = <0x00>;
						remote-endpoint = <0x42>;
						phandle = <0x29>;
					};
				};
			};

			usb_con: connector {
				compatible = "usb-c-connector";
				label = "USB-C";
				power-role = "sink";
				try-power-role = "sink";
				data-role = "dual";
				pd-revision = <0x200>;
				source-pdos = <0x401912c>;
				sink-pdos = <0x401912c 0x8640f12c 0xc064323c>;
				op-sink-microwatt = <0x989680>;
				phandle = <0x178>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;

						endpoint {
							remote-endpoint = <0x43>;
							phandle = <0x2a>;
						};
					};
				};
			};
		};


		pmic@20 {
			compatible = "rockchip,rk809";
			reg = <0x20>;
			interrupt-parent = <0x41>;
			interrupts = <0x03 0x08>;
			pinctrl-names = "default\0pmic-sleep\0pmic-power-off\0pmic-reset";
			pinctrl-0 = <0x45>;
			pinctrl-1 = <0x46 0x47>;
			pinctrl-2 = <0x48 0x49>;
			pinctrl-3 = <0x48 0x4a>;
			rockchip,system-power-controller;
			wakeup-source;
			#clock-cells = <0x01>;
			clock-output-names = "rk808-clkout1\0rk808-clkout2";
			pmic-reset-func = <0x00>;
			not-save-power-en = <0x01>;
			press-on-time = <0x01>;
			long-press-off-time-sec = <0x06>;
			long-press-restart = <0x01>;
			vcc1-supply = <0x44>;
			vcc2-supply = <0x44>;
			vcc3-supply = <0x44>;
			vcc4-supply = <0x44>;
			vcc5-supply = <0x44>;
			vcc6-supply = <0x44>;
			vcc7-supply = <0x44>;
			vcc8-supply = <0x44>;
			vcc9-supply = <0x44>;
			phandle = <0x137>;

			pwrkey {
				status = "okay";
			};

			pinctrl_rk8xx {
				gpio-controller;
				#gpio-cells = <0x02>;
				phandle = <0x179>;

				rk809_slppin_null {
					pins = "gpio_slp";
					function = "pin_fun0";
					phandle = <0x17a>;
				};

				rk809_slppin_slp {
					pins = "gpio_slp";
					function = "pin_fun1";
					phandle = <0x47>;
				};

				rk809_slppin_pwrdn {
					pins = "gpio_slp";
					function = "pin_fun2";
					phandle = <0x49>;
				};

				rk809_slppin_rst {
					pins = "gpio_slp";
					function = "pin_fun3";
					phandle = <0x4a>;
				};
			};

			regulators {

				DCDC_REG1 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x149970>;
					regulator-init-microvolt = <0xdbba0>;
					regulator-ramp-delay = <0x1771>;
					regulator-initial-mode = <0x02>;
					regulator-name = "vdd_logic";
					phandle = <0x75>;

					regulator-state-mem {
						regulator-off-in-suspend;
						regulator-suspend-microvolt = <0xdbba0>;
					};
				};

				DCDC_REG2 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x149970>;
					regulator-init-microvolt = <0xcf850>;
					regulator-ramp-delay = <0x1771>;
					regulator-initial-mode = <0x02>;
					regulator-name = "vdd_gpu";
					phandle = <0x71>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				DCDC_REG3 {
					regulator-always-on;
					regulator-boot-on;
					regulator-initial-mode = <0x02>;
					regulator-name = "vcc_ddr";
					phandle = <0x17b>;

					regulator-state-mem {
						regulator-on-in-suspend;
					};
				};

				DCDC_REG4 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x149970>;
					regulator-init-microvolt = <0xdbba0>;
					regulator-ramp-delay = <0x1771>;
					regulator-initial-mode = <0x02>;
					regulator-name = "vdd_npu";
					phandle = <0x33>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				DCDC_REG5 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x1b7740>;
					regulator-name = "vcc_1v8";
					phandle = <0x334>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				LDO_REG1 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0xdbba0>;
					regulator-max-microvolt = <0xdbba0>;
					regulator-name = "vdda0v9_image";
					phandle = <0x30>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				LDO_REG2 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0xdbba0>;
					regulator-max-microvolt = <0xdbba0>;
					regulator-name = "vdda_0v9";
					phandle = <0x17c>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				LDO_REG3 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0xdbba0>;
					regulator-max-microvolt = <0xdbba0>;
					regulator-name = "vdda0v9_pmu";
					phandle = <0x17d>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0xdbba0>;
					};
				};

				LDO_REG4 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x325aa0>;
					regulator-max-microvolt = <0x325aa0>;
					regulator-name = "vccio_acodec";
					phandle = <0x31>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				LDO_REG5 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x325aa0>;
					regulator-name = "vccio_sd";
					phandle = <0x32>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				LDO_REG6 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x325aa0>;
					regulator-max-microvolt = <0x325aa0>;
					regulator-name = "vcc3v3_pmu";
					phandle = <0x2f>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0x2dc6c0>;
					};
				};

				LDO_REG7 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x1b7740>;
					regulator-name = "vcca_1v8";
					phandle = <0x10a>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				LDO_REG8 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x1b7740>;
					regulator-name = "vcca1v8_pmu";
					phandle = <0x34>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				LDO_REG9 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x1b7740>;
					regulator-name = "vcca1v8_image";
					phandle = <0x17e>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				SWITCH_REG1 {
					regulator-always-on;
					regulator-boot-on;
					regulator-name = "vcc_3v3";
					phandle = <0x335>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				SWITCH_REG2 {
					regulator-always-on;
					regulator-boot-on;
					regulator-name = "vcc3v3_sd";
					phandle = <0x336>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				BOOST {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x4c4b40>;
					regulator-max-microvolt = <0x4c4b40>;
					regulator-name = "boost";
					phandle = <0x17f>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				OTG_SWITCH {
					regulator-name = "otg_switch";
					phandle = <0x180>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};
			};

			codec {
				#sound-dai-cells = <0x01>;
				compatible = "rockchip,rk817-codec";
				clocks = <0x23 0x1a3>;
				clock-names = "mclk";
				assigned-clocks = <0x23 0x1a3 0x23 0x1a6>;
				assigned-clock-rates = <0xbb8000>;
				assigned-clock-parents = <0x23 0x48 0x23 0x48>;
				pinctrl-names = "default";
				pinctrl-0 = <0x4b>;
				hp-volume = <0x03>;
				spk-volume = <0x0a>;
				capture-volume = <0x30>;
				use-ext-amplifier;
				mic-in-differential;
				spk-ctl-gpios = <0x4c 0x06 0x00>;
				spk-use-hp-channel;
				status = "okay";
				phandle = <0x12e>;
			};
			/*
			 * 2S battery (8.4V max) sensed through a resistor
			 * divider (140k/20k) into SARADC ch5; the driver
			 * applies the bat_res_up/down ratio on top of the
			 * ADC reading. Values are the factory Android ones.
			 */
			battery {
				compatible = "rk817,battery";
				ocv_table = <0x19c8 0x1ab8 0x1b0a 0x1b58 0x1b98 0x1bd2 0x1bfa 0x1c16 0x1c32 0x1c52 0x1c7c 0x1cc4 0x1d18 0x1d6c 0x1dc2 0x1e22 0x1e84 0x1eee 0x1f5e 0x1fde 0x20aa>;
				design_capacity = <0x1405>;
				design_qmax = <0x157c>;
				bat_res = <0x96>;
				sleep_enter_current = <0x12c>;
				sleep_exit_current = <0x12c>;
				sleep_filter_current = <0x64>;
				power_off_thresd = <0x19c8>;
				zero_algorithm_vol = <0x1e14>;
				max_soc_offset = <0x3c>;
				monitor_sec = <0x05>;
				sample_res = <0x0a>;
				virtual_power = <0x00>;
				bat_res_up = <0x8c>;
				bat_res_down = <0x14>;
				design_max_voltage = <0x206c>;
				io-channels = <0x1dd 0x05>;
				io-channel-names = "battery-chan-5";
				enough-led-ctl-gpios = <0x41 0x1e 0x00>;
				charging-led-ctl-gpios = <0x41 0x1d 0x00>;
				status = "okay";
			};
		};
	};

	serial@fdd50000 {
		compatible = "rockchip,rk3568-uart\0snps,dw-apb-uart";
		reg = <0x00 0xfdd50000 0x00 0x100>;
		interrupts = <0x00 0x74 0x04>;
		clocks = <0x3b 0x0b 0x3b 0x2c>;
		clock-names = "baudclk\0apb_pclk";
		reg-shift = <0x02>;
		reg-io-width = <0x04>;
		dmas = <0x4d 0x00 0x4d 0x01>;
		pinctrl-names = "default";
		pinctrl-0 = <0x4e>;
		status = "disabled";
		phandle = <0x181>;
	};

	pwm@fdd70000 {
		compatible = "rockchip,rk3568-pwm\0rockchip,rk3328-pwm";
		reg = <0x00 0xfdd70000 0x00 0x10>;
		#pwm-cells = <0x03>;
		pinctrl-names = "active";
		pinctrl-0 = <0x4f>;
		clocks = <0x3b 0x0d 0x3b 0x30>;
		clock-names = "pwm\0pclk";
		status = "disabled";
		phandle = <0x182>;
	};

	pwm@fdd70010 {
		compatible = "rockchip,rk3568-pwm\0rockchip,rk3328-pwm";
		reg = <0x00 0xfdd70010 0x00 0x10>;
		#pwm-cells = <0x03>;
		pinctrl-names = "active";
		pinctrl-0 = <0x50>;
		clocks = <0x3b 0x0d 0x3b 0x30>;
		clock-names = "pwm\0pclk";
		status = "disabled";
		phandle = <0x183>;
	};

	pwm@fdd70020 {
		compatible = "rockchip,rk3568-pwm\0rockchip,rk3328-pwm";
		reg = <0x00 0xfdd70020 0x00 0x10>;
		#pwm-cells = <0x03>;
		pinctrl-names = "active";
		pinctrl-0 = <0x51>;
		clocks = <0x3b 0x0d 0x3b 0x30>;
		clock-names = "pwm\0pclk";
		status = "disabled";
		phandle = <0x184>;
	};

	pwm@fdd70030 {
		compatible = "rockchip,rk3568-pwm\0rockchip,rk3328-pwm";
		reg = <0x00 0xfdd70030 0x00 0x10>;
		interrupts = <0x00 0x52 0x04 0x00 0x56 0x04>;
		#pwm-cells = <0x03>;
		pinctrl-names = "active";
		pinctrl-0 = <0x52>;
		clocks = <0x3b 0x0d 0x3b 0x30>;
		clock-names = "pwm\0pclk";
		status = "disabled";
		phandle = <0x185>;
	};

	power-management@fdd90000 {
		compatible = "rockchip,rk3568-pmu\0syscon\0simple-mfd";
