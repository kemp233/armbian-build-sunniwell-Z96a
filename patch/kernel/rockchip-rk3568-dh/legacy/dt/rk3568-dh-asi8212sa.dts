// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Dahua DH-ASI8212SA (RK3568 door-station board) — kernel DT
 *
 * Board data extracted from the factory U-Boot DTB (uboot.bin @0x1c7e00,
 * decompiled to dh/flash_kit/uboot_config.dts) and the factory dtbo
 * fragment (reboot-mode magics). SoC-level blocks — CRU@fdd20000 /
 * PMUCRU@fdd00000, GRF/PMUGRF/USB2PHY-GRF syscons, IOMMUs, power domains,
 * CPU/GPU/NPU/DMC OPP tables, efuse — come from rk3568.dtsi/rk356x.dtsi of
 * the vendor 6.1 kernel and are inherited, not duplicated.
 *
 * Known limitations (factory kernel DTB was never recovered):
 *   - PMIC is on a private I2C bus in the factory firmware; no PMIC node
 *     here. Rails run at reset defaults, so cpufreq stays at the boot
 *     frequency (no vdd_cpu regulator) until the PMIC bus is probed.
 *   - GMAC PHY wiring taken from the factory U-Boot DTB (both MACs, phy@0
 *     on their MDIO buses, RGMII, factory tx/rx delays).
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "rk3568.dtsi"

/ {
	model = "Dahua DH-ASI8212SA";
	compatible = "dahua,dh-asi8212sa", "rockchip,rk3568";

	aliases {
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
		/* TF(SD) = mmc0 (matches U-Boot numbering); root= uses PARTUUID
		 * so SD-first and eMMC installs both work */
		mmc0 = &sdmmc0;
		mmc1 = &sdhci;
		serial2 = &uart2;
	};

	chosen {
		stdout-path = "serial2:1500000n8";
	};

	/* Factory DTB: external 125MHz clocks for both GMACs */
	gmac0_clkin: external-gmac0-clock {
		compatible = "fixed-clock";
		clock-frequency = <125000000>;
		clock-output-names = "gmac0_clkin";
		#clock-cells = <0>;
	};

	gmac1_clkin: external-gmac1-clock {
		compatible = "fixed-clock";
		clock-frequency = <125000000>;
		clock-output-names = "gmac1_clkin";
		#clock-cells = <0>;
	};

	/* 1.8V rail for SARADC (from factory DTB) */
	vcca_1v8: regulator-vcca-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcca_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	/* eDP panel rail — factory rails unknown; assume 3.3V always-on */
	vcc_panel: regulator-vcc-panel {
		compatible = "regulator-fixed";
		regulator-name = "vcc_panel";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	/*
	 * Dahua reboot-mode magics — verbatim from the factory dtbo fragment
	 * (mode-normal=0x5242c300 ... mode-charge=0x5242c30b).
	 */
	reboot-mode {
		compatible = "rockchip,reboot-mode";
		mode-normal = <0x5242c300>;
		mode-recovery = <0x5242c301>;
		mode-bootloader = <0x5242c302>;
		mode-loader = <0x5242c303>;
		mode-charge = <0x5242c30b>;
	};

	/*
	 * Factory Android apps query DRM connectors "card0-DP-1" (eDP panel)
	 * and "card0-HDMI-A-1"; factory U-Boot selects rk3568-{qbt,kqj,
	 * kqj-15inch}-edp.dtb from an ADC LCD-ID. Panel is eDP on vp0.
	 * Factory kernel DTB (panel timing) was never recovered — generic
	 * 1920x1080@60 eDP timing as the first attempt.
	 */
	edp_panel: edp-panel {
		compatible = "simple-panel";
		power-supply = <&vcc_panel>;
		panel-timing {
			clock-frequency = <141400000>;
			hactive = <1920>;
			vactive = <1080>;
			hfront-porch = <48>;
			hback-porch = <80>;
			hsync-len = <32>;
			vfront-porch = <3>;
			vback-porch = <23>;
			vsync-len = <5>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;
			pixelclk-active = <0>;
		};
		port {
			panel_in_edp: endpoint {
				remote-endpoint = <&edp_out_panel>;
			};
		};
	};

	/* Recovery/MASKROM key on SARADC ch0 (factory: press < 9uV) */
	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 0>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;
		status = "okay";

		volumeup-key {
			label = "volume up";
			linux,code = <KEY_VOLUMEUP>;
			press-threshold-microvolt = <9>;
		};
	};

	/* ===== WiFi: AP6236 (BCM43438A0) on SDIO sdmmc1 ===== */
	wireless_wlan: wireless-wlan {
		compatible = "wlan-platdata";
		rockchip,grf = <&grf>;
		wifi_chip_type = "ap6236";
		sdio_vref = <1800>;
		status = "okay";
	};
};

/* Debug console, 1.5MBaud */
&uart2 {
	status = "okay";
};

/* ===== Display pipeline: VOP2 (vp0) -> eDP @fe0c0000 -> panel ===== */
&vop {
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

&edp_phy {
	status = "okay";
};

&edp {
	status = "okay";
	ports {
		port@0 {
			edp_in_vp0: endpoint@0 {
				status = "okay";
			};
		};
		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
			edp_out_panel: endpoint {
				remote-endpoint = <&panel_in_edp>;
			};
		};
	};
};

&display_subsystem {
	route {
		route_edp {
			status = "okay";
			logo,mode = "center";
			charge_logo,mode = "center";
			connect = <&vp0_out_edp>;
		};
	};
};

/* ===== WiFi: AP6236 (BCM43438A0) on SDIO sdmmc1 ===== */
&sdmmc1 {
	#address-cells = <1>;
	#size-cells = <0>;
	bus-width = <4>;
	cap-sdio-irq;
	keep-power-in-suspend;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1_clk &sdmmc1_cmd &sdmmc1_bus4>;
	status = "okay";

	sdwifi: wifi@1 {
		compatible = "brcm,bcm4329-fmac";
		reg = <1>;
	};
};

/*
 * GMAC0 — factory values: RGMII, clock_in_out=output, tx_delay=0x3c,
 * rx_delay=0x2f, PHY reset GPIO2_D3 active-low, PHY@0 on mdio0.
 */
&gmac0 {
	phy-mode = "rgmii";
	clock_in_out = "output";
	assigned-clocks = <&cru SCLK_GMAC0_RX_TX>, <&cru SCLK_GMAC0>;
	assigned-clock-parents = <&cru SCLK_GMAC0_RGMII_SPEED>, <&gmac0_clkin>;
	snps,reset-gpio = <&gpio2 RK_PD3 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;
	tx_delay = <0x3c>;
	rx_delay = <0x2f>;
	phy-handle = <&rgmii_phy0>;
	status = "okay";
};

&mdio0 {
	rgmii_phy0: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0>;
	};
};

/*
 * GMAC1 (M1 pins) — factory values: RGMII, clock_in_out=output,
 * tx_delay=0x4f, rx_delay=0x26, PHY reset GPIO2_D1 active-low, PHY@0 on mdio1.
 */
&gmac1 {
	phy-mode = "rgmii";
	clock_in_out = "output";
	assigned-clocks = <&cru SCLK_GMAC1_RX_TX>, <&cru SCLK_GMAC1>;
	assigned-clock-parents = <&cru SCLK_GMAC1_RGMII_SPEED>, <&gmac1_clkin>;
	pinctrl-0 = <&gmac1m1_miim
		     &gmac1m1_tx_bus2
		     &gmac1m1_rx_bus2
		     &gmac1m1_rgmii_clk
		     &gmac1m1_clkinout
		     &gmac1m1_rgmii_bus>;
	snps,reset-gpio = <&gpio2 RK_PD1 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;
	tx_delay = <0x4f>;
	rx_delay = <0x26>;
	phy-handle = <&rgmii_phy1>;
	status = "okay";
};

&mdio1 {
	rgmii_phy1: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0>;
	};
};

/* eMMC — HS200 8-bit, 200MHz max (factory values) */
&sdhci {
	bus-width = <8>;
	max-frequency = <200000000>;
	non-removable;
	mmc-hs200-1_8v;
	status = "okay";
};

/* SD card — 150MHz max, card-detect GPIO0_A4 (factory values) */
&sdmmc0 {
	max-frequency = <150000000>;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	status = "okay";
};

/* TF slot — factory DTB has it enabled (now used for SDIO WiFi) */
&sdmmc1 {
	max-frequency = <150000000>;
	status = "okay";
};

/* USB: OTG (fcc00000) + host (fd000000), single USB2 PHY (factory: both ok) */
&usbdrd30 {
	status = "okay";
};

&usbdrd_dwc3 {
	dr_mode = "otg";
	status = "okay";
};

&usbhost30 {
	status = "okay";
};

&usb2phy0 {
	status = "okay";
};

&u2phy0_otg {
	status = "okay";
};

&u2phy0_host {
	status = "okay";
};

/* PCIe3x2 — factory DTB: enabled, 2 lanes */
&pcie3x2 {
	num-lanes = <2>;
	status = "okay";
};

/* Hardware crypto / RNG — factory DTB: enabled */
&crypto {
	status = "okay";
};

&rng {
	status = "okay";
};

/* SARADC vref */
&saradc {
	vref-supply = <&vcca_1v8>;
	status = "okay";
};

/* OTP-fuse helper block — verbatim from the factory DTB */
secure_otp@fe3a0000 {
	compatible = "rockchip,rk3568-secure-otp";
	reg = <0x0 0xfe3a0000 0x0 0x4000>;
	secure_conf = <0xfdd18008>;
	mask_addr = <0xfe880000>;
	cru_rst_addr = <0xfdd20470>;
	status = "okay";
};