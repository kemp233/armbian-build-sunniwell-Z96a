/*
 * Sunniwell Z96A RK3568 Laptop V2 — U-Boot DT
 * Recovery/download key from FACTORY U-Boot DTB (z96a-extract/factory.dts):
 *   adc-keys ch0, label "volume up", press-threshold-microvolt = <0x09>
 * Android kernel DTB has the same ladder but status=disabled (runtime keys
 * unused); reboot-mode recovery is a separate syscon path (0x5242c303).
 * Case silkscreen "Recovery" == this volume-up ADC key -> Rockchip download,
 * NOT Android /recovery partition by itself.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include "rk3568.dtsi"

/ {
	model = "Sunniwell Z96A RK3568 Laptop V2";
	compatible = "sunniwell,z96a-rk3568-laptop-v2", "rockchip,rk3568";

	aliases {
		mmc0 = &sdhci;
		mmc1 = &sdmmc0;
		serial2 = &uart2;
		i2c0 = &i2c0;
	};

	chosen {
		stdout-path = "serial2:1500000n8";
	};

	/* SARADC VREF — Android/factory kernel use vcca 1.8V; factory U-Boot
	 * extract omitted vref-supply but mainline rockchip_saradc needs it. */
	vcca_1v8: regulator-vcca-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcca_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		bootph-all;
	};

	/* Factory U-Boot: only volume-up on ch0, threshold 0x09 (9 uV) */
	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 0>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		status = "okay";
		bootph-all;

		volumeup-key {
			label = "volume up";
			linux,code = <KEY_VOLUMEUP>;
			/* factory.dts: press-threshold-microvolt = <0x09> */
			press-threshold-microvolt = <9>;
			bootph-all;
		};
	};
};

&uart2 {
	pinctrl-0 = <&uart2m0_xfer>;
	status = "okay";
};

&sdhci {
	bus-width = <8>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	non-removable;
	status = "okay";
};

&sdmmc0 {
	bus-width = <4>;
	cap-sd-highspeed;
	disable-wp;
	status = "okay";
};

&i2c0 {
	status = "okay";
	clock-frequency = <100000>;
};

&saradc {
	vref-supply = <&vcca_1v8>;
	status = "okay";
	bootph-all;
};

&usb_host0_xhci {
	status = "okay";
};

&usb_host1_xhci {
	status = "okay";
};

&usb2phy0 {
	status = "okay";
};
/* ---- z96a-pwrfix: USB VBUS rails, aligned to factory DT ---- */
/ {
	vcc5v0_host: regulator-vcc5v0-host {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio0 RK_PA6 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&z96a_vcc5v0_host_en>;
		regulator-always-on;
		regulator-boot-on;
	};

	vcc5v0_otg: regulator-vcc5v0-otg {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_otg";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&z96a_vcc5v0_otg_en>;
	};

	vcc5v0_usb2_host1: regulator-vcc5v0-usb2-host1 {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb2_host1";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio4 RK_PB3 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&z96a_vcc5v0_host1_en>;
		regulator-always-on;
		regulator-boot-on;
	};

	vcc5v0_usb2_host2: regulator-vcc5v0-usb2-host2 {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb2_host2";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio4 RK_PB1 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&z96a_vcc5v0_host2_en>;
		regulator-always-on;
		regulator-boot-on;
	};

	vcc5v0_usb_keyboard: regulator-vcc5v0-usb-keyboard {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb_keyboard";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio2 RK_PD7 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&z96a_keyboard_pwr>;
		regulator-always-on;
		regulator-boot-on;
	};
};

&pinctrl {
	z96a-usb-pwr {
		z96a_vcc5v0_host_en: z96a-vcc5v0-host-en {
			rockchip,pins = <0 RK_PA6 0 &pcfg_pull_none>;
		};

		z96a_vcc5v0_otg_en: z96a-vcc5v0-otg-en {
			rockchip,pins = <0 RK_PA5 0 &pcfg_pull_none>;
		};

		z96a_vcc5v0_host1_en: z96a-vcc5v0-host1-en {
			rockchip,pins = <4 RK_PB3 0 &pcfg_pull_none>;
		};

		z96a_vcc5v0_host2_en: z96a-vcc5v0-host2-en {
			rockchip,pins = <4 RK_PB1 0 &pcfg_pull_none>;
		};

		z96a_keyboard_pwr: z96a-keyboard-pwr {
			rockchip,pins = <2 RK_PD7 0 &pcfg_pull_none>;
		};
	};
};

&usb_host0_xhci {
	vbus-supply = <&vcc5v0_otg>;
};

&usb_host1_xhci {
	vbus-supply = <&vcc5v0_host>;
};

