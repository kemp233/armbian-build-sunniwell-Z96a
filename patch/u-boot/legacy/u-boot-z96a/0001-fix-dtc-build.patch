Fix dtc build with modern GCC by suppressing errors

The dtc-parser.y generates code that may have warnings treated as
errors with newer GCC versions. Add -Wno-error to HOSTCFLAGS for dtc.
--- a/scripts/dtc/Makefile
+++ b/scripts/dtc/Makefile
@@ -1,5 +1,5 @@
 # SPDX-License-Identifier: GPL-2.0+
-HOSTCFLAGS_dtc-objs	:= -Wno-unused-parameter
+HOSTCFLAGS_dtc-objs	:= -Wno-unused-parameter -Wno-error
 HOSTCFLAGS_dtc-lexer.lex.o := -Wno-unused-parameter -Wno-sign-compare
 HOSTCFLAGS_dtc-parser.tab.o := -Wno-unused-parameter -Wno-error
 HOSTCFLAGS_yamltree.o := -Wno-unused-parameter
