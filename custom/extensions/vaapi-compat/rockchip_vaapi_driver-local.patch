+    "-Wl,--no-as-needed"
+    EGL
+    GLESv2
+    "-Wl,--as-needed"
+    # GBM 平台: EGL_PLATFORM_GBM_KHR 需要 libgbm 建 gbm_device，
+    # 探针要靠它 headless 拿到 Mali EGL。
+    gbm
     dl
