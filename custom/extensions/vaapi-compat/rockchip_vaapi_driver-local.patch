+}
+
+static VAStatus vaMFReleaseContext(VADriverContextP ctx,
+                                   VAMFContextID mf_context,
+                                   VAContextID context) {
+    (void)ctx; (void)mf_context; (void)context;
+    return VA_STATUS_ERROR_UNIMPLEMENTED;
+}
+
+static VAStatus vaMFSubmit(VADriverContextP ctx,
+                           VAMFContextID mf_context,
+                           VAContextID* contexts,
+                           int num_contexts) {
+    (void)ctx; (void)mf_context; (void)contexts; (void)num_contexts;
