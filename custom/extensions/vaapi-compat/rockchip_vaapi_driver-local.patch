+    // 0 = 不限速率（VAProcessingRate_None）。MPP 解码器的实时性由驱动内部节流，
+    // 客户端不请求具体帧率时不应被拒。
+    *processing_rate = 0;
+    return VA_STATUS_SUCCESS;
+}
+
+static VAStatus vaSyncBuffer(VADriverContextP ctx,
