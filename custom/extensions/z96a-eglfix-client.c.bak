static int is_compositor(void) {
    char comm[64] = {0};
    FILE *f = fopen("/proc/self/comm", "r");
    if (!f) return 0;
    size_t n = fread(comm, 1, sizeof(comm) - 1, f);
    fclose(f);
    (void)n;
    return strncmp(comm, "gnome-shell", 11) == 0
        || strncmp(comm, "Xwayland", 8) == 0;
}
static void *ensure(void) {
    if (mali) return mali;
    if (is_compositor()) {
        hook = dlopen("/usr/lib/aarch64-linux-gnu/mali-egl/libmali-hook.so.1", RTLD_NOW|RTLD_GLOBAL);
        mali = dlopen("/usr/lib/aarch64-linux-gnu/mali-egl/libmali.so.1.9.0", RTLD_NOW|RTLD_GLOBAL);
        if (!mali) return 0;
        r_gpa = dlsym(hook, "eglGetProcAddress");
        if (!r_gpa) r_gpa = dlsym(mali, "eglGetProcAddress");
        r_create = r_gpa ? r_gpa("eglCreateContext") : 0;
        if (!r_create) r_create = dlsym(mali, "eglCreateContext");
        r_getdisplay = dlsym(hook, "eglGetDisplay");
        if (!r_getdisplay) r_getdisplay = dlsym(mali, "eglGetDisplay");
