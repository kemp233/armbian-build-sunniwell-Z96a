__attribute__((constructor(101))) static void eglfix_autoload(void) { ensure(); }
static void *fixed_create(void *dpy, void *cfg, void *share, const int *attribs) {
    if (!ensure()) return 0;
    void *c = 0;
    if (attribs) {
        int cl[64]; int j = 0;
        for (int i = 0; attribs[i] && i < 60; i += 2) {
            if (attribs[i] == 0x3098) continue;
            cl[j++] = attribs[i]; cl[j++] = attribs[i+1];
        }
        cl[j++] = 0;
        c = r_create(dpy, cfg, share, cl);
        if (c) return c;
    }
    int none = 0;
    c = r_create(dpy, cfg, share, &none);
    if (c) return c;
    return r_create(dpy, cfg, share, 0);
}
static int (*r_initialize)(void*, int*, int*);
static int (*r_chooseconfig)(void*, const int*, void**, int, int*);
static int (*r_bindapi)(unsigned);

void *eglGetDisplay(void *native) {
    if (!ensure()) return 0;
    if (!r_initialize) {
        r_initialize   = dlsym(mali, "eglInitialize");
        r_chooseconfig = dlsym(mali, "eglChooseConfig");
        r_bindapi      = dlsym(mali, "eglBindAPI");
    }
    void *d = r_getdisplay(native);
    int maj = 0, mn = 0;
    if (d && r_initialize(d, &maj, &mn)) return d;
    /* default/X11 等 native display 在这个 blob 上初始化必败 →
     * 兜底: mali 自家 gbm 设备 (renderD128) */
    if (!gbm_real_display && gbm_create_device) {
        int fd = open("/dev/dri/renderD128", O_RDWR | O_CLOEXEC);
        if (fd >= 0) {
            gbm_dev = gbm_create_device(fd);
            if (gbm_dev) gbm_real_display = r_getdisplay(gbm_dev);
        }
    }
    return gbm_real_display ? gbm_real_display : d;
}
void *eglGetProcAddress(const char *name) {
    if (!ensure()) return 0;
    if (strcmp(name, "eglCreateContext") == 0) return (void*)fixed_create;
    return r_gpa(name);
}
void *eglCreateContext(void *dpy, void *cfg, void *share, const int *attribs) {
    return fixed_create(dpy, cfg, share, attribs);
}
